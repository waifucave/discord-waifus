{
  "name": "@starlight-ai/discord-waifus",
  "version": "0.1.3",
  "private": false,
  "description": "Global CLI for running the Discord Waifus local orchestration stack",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waifucave/discord-waifus.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/waifucave/discord-waifus/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/waifucave/discord-waifus/issues"
  },
  "bin": {
    "waifus": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --external pm2",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "picocolors": "^1.1.1",
    "pm2": "^5.4.3",
    "smol-toml": "^1.6.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
