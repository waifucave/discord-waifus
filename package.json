{
  "name": "@waifucave/discord-waifus",
  "version": "1.5.160",
  "description": "Local Discord waifu orchestrator backend, web UI, and CLI.",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waifucave/discord-waifus.git"
  },
  "bugs": {
    "url": "https://github.com/waifucave/discord-waifus/issues"
  },
  "homepage": "https://github.com/waifucave/discord-waifus#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "ai",
    "orchestrator",
    "waifu",
    "local-first"
  ],
  "bin": {
    "waifus": "./bin/waifus.mjs"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "rm -rf dist && tsc -p tsconfig.json",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "dev": "node ./bin/waifus.mjs dev",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "waifus": "node ./bin/waifus.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/frontend/tsconfig.json --noEmit",
    "prepublishOnly": "node ./scripts/check-no-file-deps.mjs && npm run test && npm run build",
    "release:beta": "node ./scripts/release.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-frontend/",
    "assets/ocr/",
    "docs/api.md",
    "docs/old-orchestrator-prompt.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@waifucave/gateway": "0.1.1",
    "discord.js": "^14.26.4",
    "fastify": "^5.8.5",
    "smol-toml": "^1.6.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
