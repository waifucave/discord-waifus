{
  "name": "@starlight-ai/discord-waifus",
  "version": "1.5.118",
  "description": "Local Discord waifu orchestrator backend, web UI, and CLI.",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeavenllyDemon/Discord-Waifus.git"
  },
  "bugs": {
    "url": "https://github.com/HeavenllyDemon/Discord-Waifus/issues"
  },
  "homepage": "https://github.com/HeavenllyDemon/Discord-Waifus#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "ai",
    "orchestrator",
    "waifu",
    "local-first"
  ],
  "bin": {
    "waifus": "./bin/waifus.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "dev": "node ./bin/waifus.mjs dev",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "waifus": "node ./bin/waifus.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/frontend/tsconfig.json --noEmit",
    "ocr:assemble": "node ./scripts/assemble-ocr-package.mjs",
    "ocr:validate": "node ./scripts/validate-ocr-package.mjs",
    "prepublishOnly": "npm run test && npm run build"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-frontend/",
    "docs/api.md",
    "docs/old-orchestrator-prompt.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.26.4",
    "fastify": "^5.8.5",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@starlight-ai/discord-waifus-ocr-darwin-arm64": "1.5.118",
    "@starlight-ai/discord-waifus-ocr-darwin-x64": "1.5.118",
    "@starlight-ai/discord-waifus-ocr-linux-x64-gnu": "1.5.118",
    "@starlight-ai/discord-waifus-ocr-win32-x64": "1.5.118"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
