{
  "name": "@waifucave/discord-waifus",
  "version": "2.111.2",
  "description": "Local Discord waifu orchestrator backend, web UI, and CLI.",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waifucave/discord-waifus.git"
  },
  "bugs": {
    "url": "https://github.com/waifucave/discord-waifus/issues"
  },
  "homepage": "https://github.com/waifucave/discord-waifus#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "ai",
    "orchestrator",
    "waifu",
    "local-first"
  ],
  "bin": {
    "waifus": "./bin/waifus.mjs"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend && npm run build:remote-shell",
    "build:backend": "rm -rf dist && tsc -p tsconfig.json",
    "build:frontend": "vite build --config src/frontend/vite.config.ts && tsx scripts/generate-dashboard-manifest.mjs",
    "build:remote-shell": "vite build --config src/frontend/remote-shell/vite.config.ts",
    "dev": "node ./bin/waifus.mjs dev",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "waifus": "node ./bin/waifus.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "benchmark:decisions": "tsx scripts/benchmark-decisions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/frontend/tsconfig.json --noEmit && tsc -p scripts/remote-contracts/tsconfig.json",
    "contracts:sas:check": "tsx scripts/generate-sas-wordlist.ts --check",
    "contracts:sas:generate": "tsx scripts/generate-sas-wordlist.ts --write",
    "contracts:remote:check": "npm run contracts:sas:check && tsx scripts/generate-remote-contracts.ts --check",
    "contracts:remote:generate": "npm run contracts:sas:generate && tsx scripts/generate-remote-contracts.ts --write",
    "prepublishOnly": "node ./scripts/check-no-file-deps.mjs && npm run test && npm run build",
    "release:beta": "node ./scripts/release.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-frontend/",
    "dist-remote-shell/",
    "remote-compatibility.json",
    "assets/ocr/",
    "assets/laya/",
    "docs/assistant-kb/",
    "docs/api.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@waifucave/ts-connect-darwin-arm64": "0.1.13",
    "@waifucave/ts-connect-win32-x64": "0.1.13",
    "@waifucave/ts-connect-win32-arm64": "0.1.13",
    "@waifucave/ts-connect-linux-x64": "0.1.13",
    "@waifucave/ts-connect-linux-arm64": "0.1.13"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@waifucave/gateway": "0.3.1",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.5",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.9.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
